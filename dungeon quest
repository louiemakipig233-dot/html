<!DOCTYPE html>
<html>
<head>
  <title>Dungeon of the Lost Code</title>
  <style>
    body {
      background: #000;
      margin: 0;
      font-family: monospace;
      color: white;
      text-align: center;
    }
    canvas {
      display: block;
      margin: auto;
      background: #222;
      image-rendering: pixelated;
    }
    #challenge {
      margin-top: 10px;
    }
    input {
      background: black;
      border: 1px solid white;
      color: white;
      padding: 5px;
      font-family: monospace;
    }
    button {
      background: #444;
      border: 1px solid white;
      color: white;
      padding: 5px 10px;
      cursor: pointer;
    }
    button:hover {
      background: #666;
    }
  </style>
</head>
<body>
  <canvas id="game" width="160" height="160"></canvas>
  
  <div id="challenge" style="display:none;">
    <p id="puzzle-text">Solve this puzzle:</p>
    <input type="text" id="answer" placeholder="Type answer">
    <button onclick="checkAnswer()">Submit</button>
    <p id="result"></p>
  </div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

const tileSize = 16;
const map = [
  "##########",
  "#@     D #",
  "#        #",
  "#   ##   #",
  "#        #",
  "##########"
];

let player = {x:1, y:1};

function drawMap(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  for (let y=0; y<map.length; y++){
    for (let x=0; x<map[y].length; x++){
      let ch = map[y][x];
      if (ch === "#") {
        ctx.fillStyle = "#555";
        ctx.fillRect(x*tileSize, y*tileSize, tileSize, tileSize);
      } else if (ch === "@") {
        ctx.fillStyle = "yellow";
        ctx.fillRect(x*tileSize, y*tileSize, tileSize, tileSize);
      } else if (ch === "D") {
        ctx.fillStyle = "red";
        ctx.fillRect(x*tileSize, y*tileSize, tileSize, tileSize);
      }
    }
  }
}

function move(dx, dy){
  let newX = player.x + dx;
  let newY = player.y + dy;
  if (map[newY][newX] !== "#") {
    if (map[newY][newX] === "D") {
      showChallenge();
      return;
    }
    map[player.y] = replaceChar(map[player.y], " ");
    player.x = newX;
    player.y = newY;
    map[player.y] = replaceChar(map[player.y], "@");
    drawMap();
  }
}

function replaceChar(str, char){
  let arr = str.split('');
  arr[player.x] = char;
  return arr.join('');
}

function showChallenge(){
  document.getElementById("challenge").style.display = "block";
  document.getElementById("puzzle-text").innerText =
    "Fix the code: prin('HELLO')";
}

function checkAnswer(){
  let ans = document.getElementById("answer").value.trim();
  if (ans === "print('HELLO')") {
    document.getElementById("result").innerText = "✅ Gate unlocked!";
    setTimeout(()=>{
      document.getElementById("challenge").style.display = "none";
      map[player.y][player.x] = " ";
      drawMap();
    }, 1000);
  } else {
    document.getElementById("result").innerText = "❌ Try again.";
  }
}

document.addEventListener('keydown', e=>{
  if (e.key === "ArrowUp") move(0,-1);
  if (e.key === "ArrowDown") move(0,1);
  if (e.key === "ArrowLeft") move(-1,0);
  if (e.key === "ArrowRight") move(1,0);
});

drawMap();
</script>
</body>
</html>
